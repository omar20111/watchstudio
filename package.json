{
  "name": "watchstudio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "WatchStudio — 3D wrist watch designer (modular build, ships as a single HTML file)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "esbuild smoke.mjs --bundle --format=esm --platform=node --jsx=automatic --external:react --external:react-dom --outfile=node_modules/.smoke-out.mjs && node node_modules/.smoke-out.mjs",
    "combos": "esbuild combos.mjs --bundle --format=esm --platform=node --jsx=automatic --external:react --external:react-dom --outfile=node_modules/.combos-out.mjs && node node_modules/.combos-out.mjs",
    "assert": "esbuild assertrun.mjs --bundle --format=esm --platform=node --jsx=automatic --external:react --external:react-dom --outfile=node_modules/.assert-out.mjs && node node_modules/.assert-out.mjs",
    "test": "npm run assert && npm run smoke && npm run combos",
    "refs": "node scripts/refs.mjs",
    "e2e": "vite build && node e2e/run.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
